# Docling Extractor Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=document_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Input Directory Configuration
INPUT_DIRECTORY=/path/to/your/documents

# Processing Configuration
ENABLE_OCR=true
SAVE_RAW_TEXT=true
SAVE_EXTRACTED_DATA=true

# Docling Configuration
DOCLING_MODEL=default
DOCLING_OCR_ENGINE=tesseract

# LLM Configuration (for vLLM or OpenAI-compatible APIs)
# Set LLM_ENABLED=true to enable LLM-based extraction
# For vLLM: Start vLLM server first, e.g.:
#   python -m vllm.entrypoints.api_server --model Qwen/Qwen2.5-7B-Instruct --port 8000
# Then set:
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_API_KEY=empty  (vLLM doesn't require API key by default)
#
# For OpenAI API:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=your-openai-api-key
#   LLM_MODEL=gpt-4o-mini
#
# For other OpenAI-compatible APIs (Ollama, LM Studio, etc.):
#   LLM_BASE_URL=http://localhost:11434/v1  (for Ollama)
#   LLM_API_KEY=ollama  (or empty)
#   LLM_MODEL=qwen2.5:7b

LLM_ENABLED=false
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=empty
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/docling_extractor.log
